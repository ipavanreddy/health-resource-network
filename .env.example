# Copy to .env (never commit). Cloud Run reads these from Secret Manager.

# Google AI Studio key (or leave empty and use Vertex AI via ADC)
GEMINI_API_KEY=

# Gemini model ID (works on both the Gemini API and Vertex AI)
GEMINI_MODEL=gemini-2.5-flash

# true to route Gemini through Vertex AI (service account / ADC, no API key needed) instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# Vertex AI endpoint for Gemini: global (most capacity) or asia-south1 (in-country processing; may return 429)
GEMINI_LOCATION=global

# Gemini 2.5 thinking budget for text tasks: 0 = off (fastest), -1 = dynamic. Register photos always use dynamic.
GEMINI_THINKING_BUDGET=0

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset for this project
BIGQUERY_DATASET=health_resource_network

# Cloud Storage bucket: register photos + voice recordings under health-resource-network/captures/
GCS_BUCKET=

# Firebase project ID (usually = GCP project). Needs a Firestore (default) database; otherwise shown as demo.
FIREBASE_PROJECT_ID=

# Server-side Maps key (Geocoding/Routes). Empty = straight-line travel-time estimate (demo)
MAPS_API_KEY=

# Cloud Speech-to-Text / Text-to-Speech / Translation REST APIs (key restricted to those APIs).
# Empty = Gemini audio transcription (if Gemini is on) or demo transcript; browser speech synthesis.
GOOGLE_CLOUD_API_KEY=

# Forecast backend: baseline (local, explainable) | bigquery (BigQuery ML ARIMA_PLUS; run
# data/transformations/load_bigquery.py --all first)
FORECAST_BACKEND=baseline

# Force every integration into labelled demo mode even when keys are set (offline demos, tests)
FORCE_DEMO_MODE=false

# Synthetic data: deterministic seed; optional pinned reference time (ISO, IST). Empty = now
DATA_SEED=20260930
DEMO_REFERENCE_TIME=


# API
PORT=8030
CORS_ORIGINS=http://localhost:3030,http://localhost:3031
# Optional regex for extra allowed origins
CORS_ORIGIN_REGEX=
